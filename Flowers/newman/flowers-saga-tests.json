        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"test_product\",\n  \"quantity\": 3,\n  \"orderId\": 9999\n}"
        },
        "url": "{{baseUrl}}/warehouse/reserve"
      }
    },
    {
      "name": "12. 📊 ФИНАЛЬНЫЙ ОТЧЕТ",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('\\n=== 📊 ФИНАЛЬНЫЙ ОТЧЕТ ПО ТЕСТИРОВАНИЮ SAGA ===');",
              "console.log('✅ УСПЕШНЫЕ ТЕСТЫ:');",
              "console.log('   - Все три сервиса работают в транзакции');",
              "console.log('   - Баланс корректно списывается при успехе');",
              "console.log('✅ КОМПЕНСАЦИИ РАБОТАЮТ:');",
              "console.log('   - Ошибка БИЛЛИНГА → откат сразу');",
              "console.log('   - Ошибка СКЛАДА → откат биллинга');", 
              "console.log('   - Ошибка ДОСТАВКИ → откат склада и биллинга');",
              "console.log('💰 Финальный баланс: ' + pm.response.json().balance);",
              "console.log('=== ТЕСТИРОВАНИЕ ЗАВЕРШЕНО ===');",
              "",
              "pm.test('✅ Финальная проверка системы', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().balance).to.equal(150);",
