        ],
        "url": "{{baseUrl}}/billinging/balance/{{user_id}}"
      }
    },
    {
      "name": "11. 🧪 ТЕСТ 5: Проверка отдельных сервисов",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "console.log('🔧 Проверка работы отдельных сервисов:');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('✅ Сервис склада работает', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "if (jsonData === true) {",
              "    console.log('✅ СКЛАД: Резервирование товара работает');",
              "} else {",
              "    console.log('❌ СКЛАД: Ошибка резервирования');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
