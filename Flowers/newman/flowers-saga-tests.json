        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 75,\n  \"productId\": \"prod_003\",\n  \"quantity\": 1,\n  \"deliverySlot\": \"2024-01-21T05:00:00Z\"\n}"
        },
        "url": "{{baseUrl}}/orders"
      }
    },
    {
      "name": "10. 🔍 ПРОВЕРКА 4: Компенсация после ошибки доставки",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('✅ Баланс восстановлен', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('✅ КОМПЕНСАЦИЯ: Деньги возвращены (осталось 150)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.balance).to.equal(150);",
              "    console.log('✅ КОМПЕНСАЦИЯ РАБОТАЕТ: Все сервисы откатились после ошибки доставки');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
