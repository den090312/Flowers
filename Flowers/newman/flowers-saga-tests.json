        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 50,\n  \"productId\": \"out_of_stock_product\",\n  \"quantity\": 5,\n  \"deliverySlot\": \"2024-01-20T16:00:00Z\"\n}"
        },
        "url": "{{baseUrl}}/orders"
      }
    },
    {
      "name": "8. 🔍 ПРОВЕРКА 3: Компенсация после ошибки склада",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('✅ Баланс восстановлен', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('✅ КОМПЕНСАЦИЯ: Деньги возвращены (осталось 150)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.balance).to.equal(150);",
              "    console.log('✅ КОМПЕНСАЦИЯ РАБОТАЕТ: Биллинг откатился после ошибки склада');",
              "});"
